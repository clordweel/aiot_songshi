# Local environment facts (copy from *.template.md, fill secrets offline)
docs/aiot/env/*.local.md

# Agent / 脚本本地变量（复制自 config/agent-connect.env.example）
config/local.env

# 向下兼容（deprecated）：若仍存在则会被 env_loader 读取
scripts/agent_connect.local.env

# 执行留痕简报（与本仓库 docs/ 同级目录 audits/；约定见 docs/aiot/AUDITS.md）
/audits/

# 临时工作区：脚本、下载件、一次性输出（仅 tmp/README.md 受版本控制）
tmp/*
!tmp/README.md

# Nested bench apps (独立 Git 仓库；由各自 remote 管理，勿纳入本仓库)
apps/ssi_app/

# Python
__pycache__/
*.py[cod]
