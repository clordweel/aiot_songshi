# 复制为 config/local.env（勿提交）后按需填写。
# 脚本通过 scripts/lib/env_loader.py 加载；操作系统环境变量优先。

# --- REST ---
FRAPPE_SITE_URL=http://10.0.0.40
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# --- MCP（FAC）---
FAC_MCP_URL=http://10.0.0.40/api/method/frappe_assistant_core.api.fac_endpoint.handle_mcp
FAC_MCP_TOKEN=

# --- SSH / bench（推荐变量名）---
AIOT_SSH_TARGET=frappe@10.0.0.40
AIOT_BENCH_ROOT=~/frappe-bench
AIOT_BENCH_SITE=10-0-0-40.sslip.io

# --- deploy_ssi_app.py 专用覆盖（可选）---
# DEPLOY_SSI_SSH_TARGET=
# DEPLOY_SSI_SITE=

# 兼容旧名（仍支持）：AGENT_BENCH_SSH_TARGET / AGENT_BENCH_ROOT / AGENT_BENCH_SITE
